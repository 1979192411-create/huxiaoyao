<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>唬小曜 HUXIAOYAO - 潮玩手办交互体验</title>
    <style>
        /* 页面基础样式，去除边距与滚动条 */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #f7f7f7;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        /* 3D 渲染 Canvas */
        #webgl-container {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }

        /* 右下角 MediaPipe 手部追踪镜像预览窗口 */
        #camera-preview-container {
            position: absolute;
            bottom: 20px;
            right: 20px;
            width: 200px;
            height: 150px;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* 隐藏原始 Video 标签，只把结果画在 Canvas 上（支持镜像翻转） */
        #input-video {
            display: none;
        }

        #output-canvas {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scaleX(-1); /* 水平镜像翻转，符合人类操作习惯 */
        }

        /* 权限拒绝/加载提示 Overlay */
        #permission-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 20;
            text-align: center;
            color: #555;
            background: rgba(255, 255, 255, 0.85);
            padding: 24px 36px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            backdrop-filter: blur(10px);
            pointer-events: none;
            transition: opacity 0.5s ease;
        }

        #permission-overlay h2 {
            font-size: 20px;
            margin-bottom: 8px;
            color: #333;
        }

        #permission-overlay p {
            font-size: 14px;
            color: #666;
        }
    </style>

    <!-- 1. 引入 Three.js 核心库及 GLTFLoader -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>

    <!-- 2. 引入 MediaPipe Hands 及其 Camera 工具 -->
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
</head>
<body>

    <!-- WebGL 容器 -->
    <div id="webgl-container"></div>

    <!-- 右下角预览窗口 -->
    <div id="camera-preview-container">
        <video id="input-video" playsinline></video>
        <canvas id="output-canvas"></canvas>
    </div>

    <!-- 提示框 -->
    <div id="permission-overlay">
        <h2 id="overlay-title">正在请求摄像头权限...</h2>
        <p id="overlay-desc">请允许使用摄像头，以使用手势抚摸互动小虎。</p>
    </div>

    <script>
        /********************************************************
         * 1. 全局配置与状态变量
         ********************************************************/
        // 优先加载外部 glb 模型路径
        const MODEL_URL = './huxiaoyao.glb';

        // 交互区域枚举定义
        const ZONE = {
            NONE: 'NONE',
            HEAD: 'HEAD',   // 头部：抚摸头顶
            BACK: 'BACK',   // 后背：拱背松弛
            BELLY: 'BELLY'  // 腹部：向后躲闪害羞
        };

        // 当前互动状态
        let currentZone = ZONE.NONE;
        let lastZoneChangeTime = 0;
        const COOLDOWN_MS = 600; // 切换动画冷却时间（毫秒），防止识别抖动频繁跳变

        // 防抖平滑滤波参数 (Exponential Moving Average)
        let smoothedHandPos = new THREE.Vector3(0, 0, 0);
        const SMOOTH_FACTOR = 0.18; // 越小越平滑，响应越缓和

        // 视角与相机配置
        let scene, camera, renderer;
        let tigerGroup, headGroup, earLeft, earRight, tailGroup, eyelidsGroup;
        let touchPointSphere; // 代表指尖触点的柔和淡金色小球

        // 动画变量插值 Target (用于 SmoothDamp/Lerp 柔和过渡)
        const animState = {
            earRotationX: 0,     // 耳朵压低角度
            eyelidY: 0,          // 眼睑放松/闭合偏移
            tailSwingSpeed: 1,   // 尾巴摇晃速度
            tailSwingAmp: 0.15,  // 尾巴摇晃幅度
            bodyArchZ: 0,        // 拱背弯曲程度
            bodyOffsetY: 0,      // 身体沉降高度
            bodyOffsetZ: 0       // 身体躲闪后退距离
        };

        const targetAnimState = { ...animState };

        /********************************************************
         * 2. Three.js 场景初始化 (纯白影棚 + 哑光树脂质感)
         ********************************************************/
        function initThreeScene() {
            const container = document.getElementById('webgl-container');

            // 创建场景
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0xf5f5f7); // 极简纯白/浅灰阴影背景
            scene.fog = new THREE.FogExp2(0xf5f5f7, 0.05);

            // 创建相机
            camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 0.5, 5.5);

            // 创建 WebGL 渲染器
            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            renderer.outputEncoding = THREE.sRGBEncoding;
            container.appendChild(renderer.domElement);

            // 布光：模拟手办展厅柔光效果
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            scene.add(ambientLight);

            const mainLight = new THREE.DirectionalLight(0xfff5e6, 1.2);
            mainLight.position.set(3, 5, 4);
            mainLight.castShadow = true;
            mainLight.shadow.mapSize.width = 2048;
            mainLight.shadow.mapSize.height = 2048;
            mainLight.shadow.bias = -0.0001;
            scene.add(mainLight);

            const rimLight = new THREE.DirectionalLight(0xa6d8ff, 0.8);
            rimLight.position.set(-3, 3, -3);
            scene.add(rimLight);

            // 地面影棚微柔和阴影接收面
            const shadowPlaneGeo = new THREE.PlaneGeometry(20, 20);
            const shadowPlaneMat = new THREE.ShadowMaterial({ opacity: 0.12 });
            const shadowPlane = new THREE.Mesh(shadowPlaneGeo, shadowPlaneMat);
            shadowPlane.rotation.x = -Math.PI / 2;
            shadowPlane.position.y = -1.2;
            shadowPlane.receiveShadow = true;
            scene.add(shadowPlane);

            // 柔和淡金色指尖触点小球
            const touchGeo = new THREE.SphereGeometry(0.08, 32, 32);
            const touchMat = new THREE.MeshStandardMaterial({
                color: 0xffe082,
                emissive: 0xffca28,
                emissiveIntensity: 0.6,
                roughness: 0.2,
                metalness: 0.1,
                transparent: true,
                opacity: 0.85
            });
            touchPointSphere = new THREE.Mesh(touchGeo, touchMat);
            touchPointSphere.visible = false;
            scene.add(touchPointSphere);

            // 优先加载外部 glb 模型
            loadTigerModel();

            // 窗口 resize 监听
            window.addEventListener('resize', onWindowResize, false);
        }

        /********************************************************
         * 3. 优先加载外部 glb 模型与降级备用构建
         ********************************************************/
        function loadTigerModel() {
            const loader = new THREE.GLTFLoader();
            loader.load(
                MODEL_URL,
                (gltf) => {
                    tigerGroup = gltf.scene;
                    tigerGroup.position.set(0, -0.6, 0);
                    tigerGroup.scale.set(1, 1, 1); // 可根据实际模型大小在此调整缩放
                    
                    // 递归遍历模型，开启阴影投射和接收
                    tigerGroup.traverse((child) => {
                        if (child.isMesh) {
                            child.castShadow = true;
                            child.receiveShadow = true;
                        }
                    });

                    // 尝试在加载的模型中通过名称或层级绑定交互部件（若模型未分层，则由根节点整体参与互动响应）
                    headGroup = tigerGroup.getObjectByName('Head') || tigerGroup;
                    earLeft = tigerGroup.getObjectByName('EarLeft');
                    earRight = tigerGroup.getObjectByName('EarRight');
                    tailGroup = tigerGroup.getObjectByName('Tail');

                    scene.add(tigerGroup);
                    console.log('成功加载外部 glb 模型: huxiaoyao.glb');
                },
                (xhr) => {
                    // 加载进度
                    if (xhr.lengthComputable) {
                        const percentComplete = (xhr.loaded / xhr.total) * 100;
                        console.log(`模型加载进度: ${Math.round(percentComplete)}%`);
                    }
                },
                (error) => {
                    console.warn('未找到外部 huxiaoyao.glb 或加载失败，自动降级为程序化几何体小虎:', error);
                    buildProceduralTiger();
                }
            );
        }

        // 程序化复刻潮玩小虎“唬小曜” (备用降级方案)
        function buildProceduralTiger() {
            tigerGroup = new THREE.Group();
            tigerGroup.position.set(0, -0.6, 0);

            const yellowResinMat = new THREE.MeshStandardMaterial({ color: 0xffc107, roughness: 0.35, metalness: 0.05 });
            const whiteResinMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.4, metalness: 0.0 });
            const blackMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.3 });
            const pinkMat = new THREE.MeshStandardMaterial({ color: 0xff8a80, roughness: 0.5 });

            // 身体
            const bodyGeo = new THREE.SphereGeometry(0.8, 32, 32);
            bodyGeo.scale(1, 1.1, 0.95);
            const bodyMesh = new THREE.Mesh(bodyGeo, yellowResinMat);
            bodyMesh.position.y = 0.6;
            bodyMesh.castShadow = true;
            bodyMesh.receiveShadow = true;
            tigerGroup.add(bodyMesh);

            // 白肚皮
            const bellyGeo = new THREE.SphereGeometry(0.52, 32, 32);
            bellyGeo.scale(0.85, 0.9, 0.4);
            const bellyMesh = new THREE.Mesh(bellyGeo, whiteResinMat);
            bellyMesh.position.set(0, 0.55, 0.58);
            tigerGroup.add(bellyMesh);

            // 头部组
            headGroup = new THREE.Group();
            headGroup.position.set(0, 1.45, 0.05);

            const headGeo = new THREE.SphereGeometry(0.9, 32, 32);
            headGeo.scale(1.15, 0.95, 1.0);
            const headMesh = new THREE.Mesh(headGeo, yellowResinMat);
            headMesh.castShadow = true;
            headGroup.add(headMesh);

            const muzzleGeo = new THREE.SphereGeometry(0.45, 32, 32);
            muzzleGeo.scale(1.2, 0.65, 0.5);
            const muzzleMesh = new THREE.Mesh(muzzleGeo, whiteResinMat);
            muzzleMesh.position.set(0, -0.22, 0.68);
            headGroup.add(muzzleMesh);

            // 耳朵
            const earGeo = new THREE.ConeGeometry(0.28, 0.45, 32);
            earGeo.rotateX(0.2);

            earLeft = new THREE.Group();
            earLeft.position.set(-0.7, 0.7, 0);
            const earLeftMesh = new THREE.Mesh(earGeo, yellowResinMat);
            earLeftMesh.rotation.z = 0.3;
            earLeft.add(earLeftMesh);

            const innerEarGeo = new THREE.ConeGeometry(0.18, 0.32, 32);
            const innerEarLeft = new THREE.Mesh(innerEarGeo, pinkMat);
            innerEarLeft.position.set(0, 0, 0.05);
            innerEarLeft.rotation.z = 0.3;
            earLeft.add(innerEarLeft);

            earRight = earLeft.clone();
            earRight.position.set(0.7, 0.7, 0);
            earRight.children[0].rotation.z = -0.3;
            earRight.children[1].rotation.z = -0.3;

            headGroup.add(earLeft);
            headGroup.add(earRight);

            // 眼睛
            const eyeGeo = new THREE.SphereGeometry(0.22, 32, 32);
            eyeGeo.scale(1, 1.1, 0.3);

            const eyeLeft = new THREE.Mesh(eyeGeo, blackMat);
            eyeLeft.position.set(-0.38, 0.1, 0.78);
            eyeLeft.rotation.z = -0.25;
            eyeLeft.rotation.y = -0.2;
            headGroup.add(eyeLeft);

            const eyeRight = eyeLeft.clone();
            eyeRight.position.x = 0.38;
            eyeRight.rotation.z = 0.25;
            eyeRight.rotation.y = 0.2;
            headGroup.add(eyeRight);

            // 眼睑
            eyelidsGroup = new THREE.Group();
            const eyelidGeo = new THREE.BoxGeometry(0.45, 0.2, 0.2);
            const eyelidLeft = new THREE.Mesh(eyelidGeo, yellowResinMat);
            eyelidLeft.position.set(-0.38, 0.25, 0.82);
            eyelidLeft.rotation.z = -0.25;

            const eyelidRight = eyelidLeft.clone();
            eyelidRight.position.x = 0.38;
            eyelidRight.rotation.z = 0.25;

            eyelidsGroup.add(eyelidLeft);
            eyelidsGroup.add(eyelidRight);
            headGroup.add(eyelidsGroup);

            // 额头“王”字
            const stripeMat = blackMat;
            const king1 = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.05, 0.02), stripeMat);
            king1.position.set(0, 0.55, 0.88);
            headGroup.add(king1);

            const king2 = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.04, 0.02), stripeMat);
            king2.position.set(0, 0.42, 0.91);
            headGroup.add(king2);

            const kingVert = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.25, 0.02), stripeMat);
            kingVert.position.set(0, 0.48, 0.9);
            headGroup.add(kingVert);

            tigerGroup.add(headGroup);

            // 四肢
            const limbGeo = new THREE.CylinderGeometry(0.18, 0.2, 0.4, 32);
            const armLeft = new THREE.Mesh(limbGeo, yellowResinMat);
            armLeft.position.set(-0.75, 0.6, 0.2);
            armLeft.rotation.z = 0.4;
            tigerGroup.add(armLeft);

            const armRight = armLeft.clone();
            armRight.position.x = 0.75;
            armRight.rotation.z = -0.4;
            tigerGroup.add(armRight);

            const legLeft = new THREE.Mesh(limbGeo, yellowResinMat);
            legLeft.position.set(-0.4, 0.15, 0.1);
            tigerGroup.add(legLeft);

            const legRight = legLeft.clone();
            legRight.position.x = 0.4;
            tigerGroup.add(legRight);

            // 尾巴
            tailGroup = new THREE.Group();
            tailGroup.position.set(0, 0.2, -0.7);

            const tailGeo = new THREE.CylinderGeometry(0.1, 0.07, 0.8, 16);
            tailGeo.translate(0, 0.4, 0);
            const tailMesh = new THREE.Mesh(tailGeo, yellowResinMat);
            tailMesh.rotation.x = -0.8;
            tailGroup.add(tailMesh);
            tigerGroup.add(tailGroup);

            scene.add(tigerGroup);
        }

        /********************************************************
         * 4. 碰撞区域判定逻辑
         ********************************************************/
        function checkCollisionZones(touchPos) {
            if (!touchPointSphere.visible || !tigerGroup) return ZONE.NONE;

            const localPos = touchPos.clone().sub(tigerGroup.position);

            // 头部区域
            const headCenter = new THREE.Vector3(0, 1.45, 0.1);
            if (localPos.distanceTo(headCenter) < 0.95) {
                return ZONE.HEAD;
            }

            // 腹部区域
            const bellyCenter = new THREE.Vector3(0, 0.6, 0.5);
            if (localPos.distanceTo(bellyCenter) < 0.7) {
                return ZONE.BELLY;
            }

            // 后背区域
            const backCenter = new THREE.Vector3(0, 0.7, -0.5);
            if (localPos.distanceTo(backCenter) < 0.75) {
                return ZONE.BACK;
            }

            return ZONE.NONE;
        }

        /********************************************************
         * 5. 状态机与动画目标更新
         ********************************************************/
        function updateInteractionState(detectedZone) {
            const now = Date.now();

            if (detectedZone !== currentZone && (now - lastZoneChangeTime > COOLDOWN_MS)) {
                currentZone = detectedZone;
                lastZoneChangeTime = now;
            }

            switch (currentZone) {
                case ZONE.HEAD:
                    targetAnimState.earRotationX = 0.5;
                    targetAnimState.eyelidY = -0.12;
                    targetAnimState.tailSwingSpeed = 3.5;
                    targetAnimState.tailSwingAmp = 0.35;
                    targetAnimState.bodyArchZ = 0;
                    targetAnimState.bodyOffsetY = 0;
                    targetAnimState.bodyOffsetZ = 0;
                    break;

                case ZONE.BACK:
                    targetAnimState.earRotationX = 0.1;
                    targetAnimState.eyelidY = -0.05;
                    targetAnimState.tailSwingSpeed = 1.0;
                    targetAnimState.tailSwingAmp = 0.1;
                    targetAnimState.bodyArchZ = -0.15;
                    targetAnimState.bodyOffsetY = -0.12;
                    targetAnimState.bodyOffsetZ = 0;
                    break;

                case ZONE.BELLY:
                    targetAnimState.earRotationX = -0.2;
                    targetAnimState.eyelidY = 0.05;
                    targetAnimState.tailSwingSpeed = 4.0;
                    targetAnimState.tailSwingAmp = 0.4;
                    targetAnimState.bodyArchZ = 0.1;
                    targetAnimState.bodyOffsetY = 0;
                    targetAnimState.bodyOffsetZ = -0.3;
                    break;

                case ZONE.NONE:
                default:
                    targetAnimState.earRotationX = 0;
                    targetAnimState.eyelidY = 0;
                    targetAnimState.tailSwingSpeed = 1.2;
                    targetAnimState.tailSwingAmp = 0.15;
                    targetAnimState.bodyArchZ = 0;
                    targetAnimState.bodyOffsetY = 0;
                    targetAnimState.bodyOffsetZ = 0;
                    break;
            }
        }

        /********************************************************
         * 6. 实时动画渲染平滑更新
         ********************************************************/
        function animateScene() {
            requestAnimationFrame(animateScene);

            const time = clock.getElapsedTime();
            const lerpFactor = 0.08;

            animState.earRotationX += (targetAnimState.earRotationX - animState.earRotationX) * lerpFactor;
            animState.eyelidY += (targetAnimState.eyelidY - animState.eyelidY) * lerpFactor;
            animState.tailSwingSpeed += (targetAnimState.tailSwingSpeed - animState.tailSwingSpeed) * lerpFactor;
            animState.tailSwingAmp += (targetAnimState.tailSwingAmp - animState.tailSwingAmp) * lerpFactor;
            animState.bodyArchZ += (targetAnimState.bodyArchZ - animState.bodyArchZ) * lerpFactor;
            animState.bodyOffsetY += (targetAnimState.bodyOffsetY - animState.bodyOffsetY) * lerpFactor;
            animState.bodyOffsetZ += (targetAnimState.bodyOffsetZ - animState.bodyOffsetZ) * lerpFactor;

            if (earLeft && earRight) {
                earLeft.rotation.x = animState.earRotationX;
                earRight.rotation.x = animState.earRotationX;
            }

            if (eyelidsGroup) {
                eyelidsGroup.position.y = animState.eyelidY;
            }

            if (tailGroup) {
                tailGroup.rotation.z = Math.sin(time * animState.tailSwingSpeed) * animState.tailSwingAmp;
            }

            const breathOffsetY = Math.sin(time * 2.0) * 0.02;

            if (tigerGroup) {
                tigerGroup.position.y = -0.6 + animState.bodyOffsetY + breathOffsetY;
                tigerGroup.position.z = animState.bodyOffsetZ;
                tigerGroup.rotation.x = animState.bodyArchZ;
            }

            renderer.render(scene, camera);
        }

        const clock = new THREE.Clock();

        /********************************************************
         * 7. MediaPipe Hands 追踪与摄像机集成
         ********************************************************/
        const videoElement = document.getElementById('input-video');
        const canvasElement = document.getElementById('output-canvas');
        const canvasCtx = canvasElement.getContext('2d');
        const overlay = document.getElementById('permission-overlay');

        function initMediaPipe() {
            const hands = new Hands({
                locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
            });

            hands.setOptions({
                maxNumHands: 1,
                modelComplexity: 1,
                minDetectionConfidence: 0.6,
                minTrackingConfidence: 0.6
            });

            hands.onResults(onHandResults);

            const cameraUtils = new Camera(videoElement, {
                onFrame: async () => {
                    await hands.send({ image: videoElement });
                },
                width: 640,
                height: 480
            });

            cameraUtils.start()
                .then(() => {
                    overlay.style.opacity = '0';
                    setTimeout(() => overlay.style.display = 'none', 500);
                })
                .catch((err) => {
                    console.error('摄像头请求被拒绝或不可用:', err);
                    document.getElementById('overlay-title').innerText = '无法访问摄像头';
                    document.getElementById('overlay-desc').innerText = '请在浏览器设置中开启摄像头权限后重试。';
                });
        }

        function onHandResults(results) {
            canvasElement.width = videoElement.videoWidth || 320;
            canvasElement.height = videoElement.videoHeight || 240;

            canvasCtx.save();
            canvasCtx.clearRect(0, 0, canvasElement.width, canvasElement.height);
            canvasCtx.drawImage(results.image, 0, 0, canvasElement.width, canvasElement.height);

            if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
                const landmarks = results.multiHandLandmarks[0];
                const indexTip = landmarks[8];

                canvasCtx.fillStyle = '#ffca28';
                canvasCtx.beginPath();
                canvasCtx.arc(indexTip.x * canvasElement.width, indexTip.y * canvasElement.height, 6, 0, 2 * Math.PI);
                canvasCtx.fill();

                const rawX = (0.5 - indexTip.x) * 5.2;
                const rawY = (0.5 - indexTip.y) * 3.8;
                const rawZ = (0.5 - indexTip.z) * 2.0;

                const rawTargetPos = new THREE.Vector3(rawX, rawY, rawZ);
                smoothedHandPos.lerp(rawTargetPos, SMOOTH_FACTOR);

                touchPointSphere.position.copy(smoothedHandPos);
                touchPointSphere.visible = true;

                const activeZone = checkCollisionZones(smoothedHandPos);
                updateInteractionState(activeZone);

            } else {
                touchPointSphere.visible = false;
                updateInteractionState(ZONE.NONE);
            }

            canvasCtx.restore();
        }

        /********************************************************
         * 8. 窗口自适应与启动
         ********************************************************/
        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        window.addEventListener('DOMContentLoaded', () => {
            initThreeScene();
            animateScene();
            initMediaPipe();
        });
    </script>
</body>
</html>
